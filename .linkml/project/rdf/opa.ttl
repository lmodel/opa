	linkml:default_prefix "openpolicyagent" ;
	linkml:default_range <https://w3id.org/lmodel/opa/string> ;
	linkml:description "A LinkML model of eight of the JSON formats Open Policy Agent defines: the IR plan, the bundle manifest, the authorization policy input, the capabilities document, the built-in function metadata, the version index, the decision log event and the status report. Each module renders one format and keeps OPA's keys, so the schema checks a document OPA writes as it is, with no key renamed. The lokf adapt copy renames seven keys LOKF defines with another meaning." ;
	linkml:enums <https://w3id.org/lmodel/opa/OpaBundleType> , <https://w3id.org/lmodel/opa/OpaFeature> , <https://w3id.org/lmodel/opa/OpaFutureKeyword> , <https://w3id.org/lmodel/opa/OpaPluginState> ;
