	rdfs:label "OpaAssignVarOnceStmtBody" ;
	rdfs:subClassOf openpolicyagent:OpaStmtBody , _:c14n398 , _:c14n460 , _:c14n779 , _:c14n858 , _:c14n911 , _:c14n999 ;
	skos:definition "AssignVarOnceStmt represents an assignment of one local variable to another. If the target is defined, execution aborts with a conflict error." ;
	skos:exactMatch <https://openpolicyagent.org/schemas/ir/v1/plan.schema.json#/$defs/AssignVarOnceStmt> ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaAssignVarStmt a owl:Class ;
	rdfs:label "OpaAssignVarStmt" ;
	rdfs:subClassOf openpolicyagent:OpaStmt , _:c14n112 , _:c14n136 , _:c14n245 , _:c14n294 , _:c14n707 , _:c14n954 ;
	skos:definition "A statement of kind AssignVarStmt, with its fields in `stmt`." ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaAssignVarStmtBody a owl:Class ;
	rdfs:label "OpaAssignVarStmtBody" ;
	rdfs:subClassOf openpolicyagent:OpaStmtBody , _:c14n196 , _:c14n582 , _:c14n7 , _:c14n824 , _:c14n863 , _:c14n976 ;
	skos:definition "AssignVarStmt represents an assignment of one local variable to another." ;
	skos:exactMatch <https://openpolicyagent.org/schemas/ir/v1/plan.schema.json#/$defs/AssignVarStmt> ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaAuthorizationInput a owl:Class ;
	rdfs:label "OpaAuthorizationInput" ;
	rdfs:subClassOf _:c14n111 , _:c14n300 , _:c14n317 , _:c14n319 , _:c14n342 , _:c14n420 , _:c14n43 , _:c14n628 , _:c14n659 , _:c14n705 , _:c14n756 , _:c14n765 , _:c14n818 , _:c14n825 , _:c14n857 , _:c14n873 , _:c14n945 , _:c14n947 , _:c14n967 ;
	skos:definition "The OPA Authorization Policy Input document." ;
	skos:inScheme openpolicyagent:authorization_input ;
	skos:note "OPA's schema requires every key and makes the body an object. The server leaves out identity, client_certificates and body when the request has none, and a body can be any JSON value. So those three are optional here, and the body takes any value." .
openpolicyagent:OpaBlock a owl:Class ;
	rdfs:label "OpaBlock" ;
	rdfs:subClassOf _:c14n384 , _:c14n919 ;
	skos:definition "Block represents an ordered sequence of statements to execute. Blocks are executed until a return statement is encountered, a statement is undefined, or there are no more statements." ;
	skos:exactMatch <https://openpolicyagent.org/schemas/ir/v1/plan.schema.json#/$defs/Block> ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaBlockStmt a owl:Class ;
	rdfs:label "OpaBlockStmt" ;
	rdfs:subClassOf openpolicyagent:OpaStmt , _:c14n1016 , _:c14n1037 , _:c14n468 , _:c14n539 , _:c14n569 , _:c14n768 ;
	skos:definition "A statement of kind BlockStmt, with its fields in `stmt`." ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaBlockStmtBody a owl:Class ;
	rdfs:label "OpaBlockStmtBody" ;
	rdfs:subClassOf openpolicyagent:OpaStmtBody , _:c14n351 , _:c14n471 ;
	skos:definition "BlockStmt represents a nested block. Nested blocks and break statements can be used to short-circuit execution." ;
	skos:exactMatch <https://openpolicyagent.org/schemas/ir/v1/plan.schema.json#/$defs/BlockStmt> ;
	skos:inScheme openpolicyagent:ir_plan .
