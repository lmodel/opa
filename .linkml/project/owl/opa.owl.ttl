<https://w3id.org/lmodel/opa.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/open-policy-agent/opa/tree/482d9e368c2ddfed67ced59259fa6a247bb5f1e5> ;
	dcterms:title "Open Policy Agent (OPA)" ;
	pav:version "1.22.2" ;
	schema1:keywords "CNCF" , "Open Policy Agent" , "Rego" , "policy as code" ;
	a owl:Ontology ;
	rdfs:label "opa" ;
	rdfs:seeAlso <https://lmodel.github.io/opa> , <https://www.openpolicyagent.org/docs> ;
	skos:definition "A LinkML model of eight of the JSON formats Open Policy Agent defines: the IR plan, the bundle manifest, the authorization policy input, the capabilities document, the built-in function metadata, the version index, the decision log event and the status report. Each module renders one format and keeps OPA's keys, so the schema checks a document OPA writes as it is, with no key renamed. The lokf adapt copy renames seven keys LOKF defines with another meaning." ;
	openpolicyagent:upstream_commit "482d9e368c2ddfed67ced59259fa6a247bb5f1e5" ;
	openpolicyagent:upstream_license "Apache-2.0" ;
	openpolicyagent:upstream_release_date "2026-11-05" ;
	openpolicyagent:upstream_tag "v1.22.2" .
openpolicyagent:OpaAnyType a owl:Class ;
	rdfs:label "OpaAnyType" ;
	rdfs:subClassOf openpolicyagent:OpaType , _:c14n1054 , _:c14n358 , _:c14n392 , _:c14n526 , _:c14n730 ;
	skos:definition "A union of the types it lists in `of`, or any value when it lists none." ;
	skos:inScheme openpolicyagent:common .
openpolicyagent:OpaArrayAppendStmt a owl:Class ;
	rdfs:label "OpaArrayAppendStmt" ;
	rdfs:subClassOf openpolicyagent:OpaStmt , _:c14n223 , _:c14n328 , _:c14n379 , _:c14n436 , _:c14n711 , _:c14n972 ;
	skos:definition "A statement of kind ArrayAppendStmt, with its fields in `stmt`." ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaArrayAppendStmtBody a owl:Class ;
	rdfs:label "OpaArrayAppendStmtBody" ;
	rdfs:subClassOf openpolicyagent:OpaStmtBody , _:c14n1 , _:c14n211 , _:c14n438 , _:c14n530 , _:c14n635 , _:c14n640 ;
	skos:definition "ArrayAppendStmt represents a dynamic append operation of a value onto an array." ;
	skos:exactMatch <https://openpolicyagent.org/schemas/ir/v1/plan.schema.json#/$defs/ArrayAppendStmt> ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaArrayType a owl:Class ;
	rdfs:label "OpaArrayType" ;
	rdfs:subClassOf openpolicyagent:OpaType , _:c14n190 , _:c14n203 , _:c14n278 , _:c14n504 , _:c14n622 , _:c14n866 , _:c14n937 , _:c14n966 ;
	skos:definition "An array, with a type per position in `static` and one for the rest in `dynamic`." ;
	skos:inScheme openpolicyagent:common .
openpolicyagent:OpaAssignIntStmt a owl:Class ;
	rdfs:label "OpaAssignIntStmt" ;
	rdfs:subClassOf openpolicyagent:OpaStmt , _:c14n149 , _:c14n238 , _:c14n350 , _:c14n594 , _:c14n644 , _:c14n906 ;
	skos:definition "A statement of kind AssignIntStmt, with its fields in `stmt`." ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaAssignIntStmtBody a owl:Class ;
	rdfs:label "OpaAssignIntStmtBody" ;
	rdfs:subClassOf openpolicyagent:OpaStmtBody , _:c14n391 , _:c14n495 , _:c14n618 , _:c14n836 , _:c14n934 , _:c14n942 ;
	skos:definition "AssignIntStmt represents an assignment of an integer value to a local variable." ;
	skos:exactMatch <https://openpolicyagent.org/schemas/ir/v1/plan.schema.json#/$defs/AssignIntStmt> ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaAssignVarOnceStmt a owl:Class ;
	rdfs:label "OpaAssignVarOnceStmt" ;
