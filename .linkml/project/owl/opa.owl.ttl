	rdfs:subClassOf openpolicyagent:OpaOperand , _:c14n1010 , _:c14n547 , _:c14n773 , _:c14n88 , _:c14n946 , _:c14n968 ;
	skos:definition "Bool represents a constant boolean." ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaBooleanType a owl:Class ;
	rdfs:label "OpaBooleanType" ;
	rdfs:subClassOf openpolicyagent:OpaType , _:c14n499 , _:c14n787 , _:c14n955 ;
	skos:definition "A boolean." ;
	skos:inScheme openpolicyagent:common .
openpolicyagent:OpaBreakStmt a owl:Class ;
	rdfs:label "OpaBreakStmt" ;
	rdfs:subClassOf openpolicyagent:OpaStmt , _:c14n1031 , _:c14n231 , _:c14n30 , _:c14n369 , _:c14n48 , _:c14n718 ;
	skos:definition "A statement of kind BreakStmt, with its fields in `stmt`." ;
	skos:inScheme openpolicyagent:ir_plan .
openpolicyagent:OpaBreakStmtBody a owl:Class ;
	rdfs:label "OpaBreakStmtBody" ;
	rdfs:subClassOf openpolicyagent:OpaStmtBody , _:c14n222 , _:c14n532 , _:c14n743 ;
	skos:definition "BreakStmt represents a jump out of the current block. The index specifies how many blocks to jump starting from zero (the current block)." ;
	skos:exactMatch <https://openpolicyagent.org/schemas/ir/v1/plan.schema.json#/$defs/BreakStmt> ;
	skos:inScheme openpolicyagent:ir_plan .
