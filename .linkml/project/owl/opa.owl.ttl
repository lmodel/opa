<https://w3id.org/lmodel/opa.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/open-policy-agent/opa/tree/482d9e368c2ddfed67ced59259fa6a247bb5f1e5> ;
	dcterms:title "Open Policy Agent (OPA)" ;
	pav:version "1.22.2" ;
	schema1:keywords "CNCF" , "Open Policy Agent" , "Rego" , "policy as code" ;
	a owl:Ontology ;
	rdfs:label "opa" ;
	rdfs:seeAlso <https://lmodel.github.io/opa> , <https://www.openpolicyagent.org/docs> ;
	skos:definition "A LinkML model of the JSON formats Open Policy Agent defines: the IR plan, the bundle manifest, the authorization policy input, the capabilities document, the built-in function metadata and the version index. Each module renders one format, and keeps OPA's keys, so a document OPA writes validates here unchanged." ;
	openpolicyagent:upstream_commit "482d9e368c2ddfed67ced59259fa6a247bb5f1e5" ;
	openpolicyagent:upstream_license "Apache-2.0" ;
	openpolicyagent:upstream_release_date "2026-11-05" ;
	openpolicyagent:upstream_tag "v1.22.2" .
