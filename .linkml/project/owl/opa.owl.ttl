openpolicyagent:OpaBundleStatus a owl:Class ;
	rdfs:label "OpaBundleStatus" ;
	rdfs:subClassOf _:c14n1004 , _:c14n1026 , _:c14n1047 , _:c14n110 , _:c14n15 , _:c14n166 , _:c14n17 , _:c14n177 , _:c14n208 , _:c14n214 , _:c14n239 , _:c14n270 , _:c14n343 , _:c14n364 , _:c14n39 , _:c14n401 , _:c14n405 , _:c14n431 , _:c14n475 , _:c14n486 , _:c14n490 , _:c14n564 , _:c14n566 , _:c14n567 , _:c14n585 , _:c14n605 , _:c14n626 , _:c14n642 , _:c14n654 , _:c14n672 , _:c14n706 , _:c14n736 , _:c14n74 , _:c14n762 , _:c14n843 , _:c14n897 , _:c14n912 , _:c14n924 ;
	skos:definition "The status of a bundle: its active revision, when OPA last asked for, downloaded and activated it, and the errors of the last attempt." ;
	skos:inScheme openpolicyagent:status_report ;
	skos:note "OPA writes Go's zero time, 0001-01-01T00:00:00Z, for a time that has not come yet, such as the last activation of a bundle that never activated." .
openpolicyagent:OpaBundleType\#delta a owl:Class ;
	rdfs:label "delta" ;
	rdfs:subClassOf openpolicyagent:OpaBundleType ;
	skos:definition "A delta bundle, whose JSON Patch operations change the data OPA holds." .
openpolicyagent:OpaBundleType\#snapshot a owl:Class ;
	rdfs:label "snapshot" ;
	rdfs:subClassOf openpolicyagent:OpaBundleType ;
	skos:definition "A whole bundle, whose files replace what OPA held under its roots." .
openpolicyagent:OpaBundleType a owl:Class ;
	rdfs:label "OpaBundleType" ;
	owl:unionOf _:c14n748 ;
	skos:definition "The types of bundle." ;
	skos:inScheme openpolicyagent:status_report ;
	linkml:permissible_values openpolicyagent:OpaBundleType\#delta , openpolicyagent:OpaBundleType\#snapshot .
