    {
      "name": "OpaAuthorizationInput",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaAuthorizationInput",
      "description": "The OPA Authorization Policy Input document.",
      "comments": [
        "OPA's schema requires every key and makes the body an object. The server leaves out identity, client_certificates and body when the request has none, and a body can be any JSON value, so those three are optional here and the body takes any value."
      ],
      "from_schema": "https://w3id.org/lmodel/opa/authorization_input",
      "slots": [
        "OpaAuthorizationInput_body",
        "opaAuthorizationInput__identity",
        "opaAuthorizationInput__client_certificates",
        "opaAuthorizationInput__method",
        "opaAuthorizationInput__path",
        "opaAuthorizationInput__params",
        "opaAuthorizationInput__headers"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identity",
          "description": "The caller's identity: the bearer token under --authentication=token, or the client certificate's subject under --authentication=tls.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "client_certificates",
          "description": "The client's TLS certificates under --authentication=tls, each as Go writes an x509 certificate in JSON.",
          "range": "OpaObject",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "The HTTP method of the request, in upper case.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "path",
          "description": "The request path, one segment per element.",
          "range": "string",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "params",
          "description": "The query parameters, each with its list of values.",
          "range": "OpaStringListMap",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "headers",
          "description": "The request headers, each with its list of values.",
          "range": "OpaStringListMap",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaAuthorizationInput",
      "tree_root": true,
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
