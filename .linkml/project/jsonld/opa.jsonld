          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "What went wrong, in words.",
          "@type": "SlotDefinition"
        },
        {
          "name": "http_code",
          "description": "The HTTP status code of an upload the server refused.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "metrics",
          "description": "The decision logger's metrics.",
          "range": "OpaObject",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaDecisionLogStatus",
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaPluginStatus",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaPluginStatus",
      "description": "The state of a plugin.",
      "from_schema": "https://w3id.org/lmodel/opa/status_report",
      "slots": [
