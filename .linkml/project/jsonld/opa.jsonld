  "enums": [
    {
      "name": "OpaFutureKeyword",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaFutureKeyword",
      "description": "The future keywords the capabilities files OPA includes name.",
      "from_schema": "https://w3id.org/lmodel/opa/capabilities",
      "permissible_values": [
        {
          "text": "and"
        },
        {
          "text": "contains"
        },
        {
          "text": "every"
        },
        {
          "text": "if"
        },
        {
          "text": "in"
        },
        {
          "text": "not"
        },
        {
          "text": "or"
        }
      ]
    },
    {
      "name": "OpaFeature",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaFeature",
      "description": "The language features the capabilities files OPA includes name.",
      "from_schema": "https://w3id.org/lmodel/opa/capabilities",
      "permissible_values": [
        {
          "text": "keywords_in_refs"
        },
        {
          "text": "rego_v1"
        },
        {
          "text": "rego_v1_import"
        },
        {
          "text": "rego_v2"
        },
        {
          "text": "rego_v2_import"
        },
        {
          "text": "rule_head_ref_string_prefixes"
        },
        {
          "text": "rule_head_refs"
        },
        {
          "text": "template_strings"
        }
      ]
    },
    {
      "name": "OpaPluginState",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaPluginState",
      "description": "The states a plugin reports.",
      "from_schema": "https://w3id.org/lmodel/opa/status_report",
      "permissible_values": [
        {
          "text": "NOT_READY",
          "description": "Not in an error state, but not yet ready for normal operation, as at start-up."
        },
        {
          "text": "OK",
          "description": "Working normally."
        },
        {
          "text": "ERROR",
          "description": "In an error state, and not to be taken as working."
        },
        {
          "text": "WARN",
          "description": "Working, but degraded or in a state a person may need to fix."
        }
      ]
    },
    {
      "name": "OpaBundleType",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaBundleType",
      "description": "The types of bundle.",
      "from_schema": "https://w3id.org/lmodel/opa/status_report",
      "permissible_values": [
        {
          "text": "delta",
          "description": "A delta bundle, whose JSON Patch operations change the data OPA holds."
        },
        {
          "text": "snapshot",
          "description": "A whole bundle, whose files replace what OPA held under its roots."
        }
      ]
    }
  ],
