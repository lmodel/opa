        },
        {
          "name": "state",
          "description": "The plugin's state.",
          "range": "OpaPluginState",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "More about the state, in words.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaPluginStatus",
      "@type": "ClassDefinition"
    }
