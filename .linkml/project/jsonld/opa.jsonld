        "opaStringIndexOperand__value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The operand's value.",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaStringIndexOperand",
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaDecisionLogEvent",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaDecisionLogEvent",
      "description": "A decision OPA made: the query or path, the input and result, the bundles and the instance behind it, and when and for whom it was made.",
      "from_schema": "https://w3id.org/lmodel/opa/decision_log",
      "slots": [
        "OpaDecisionLogEvent_revision",
        "OpaDecisionLogEvent_timestamp",
        "opaDecisionLogEvent__labels",
        "opaDecisionLogEvent__decision_id",
        "opaDecisionLogEvent__batch_decision_id",
        "opaDecisionLogEvent__trace_id",
        "opaDecisionLogEvent__span_id",
        "opaDecisionLogEvent__bundles",
        "opaDecisionLogEvent__path",
        "opaDecisionLogEvent__query",
        "opaDecisionLogEvent__input",
        "opaDecisionLogEvent__result",
        "opaDecisionLogEvent__intermediate_results",
        "opaDecisionLogEvent__mapped_result",
        "opaDecisionLogEvent__nd_builtin_cache",
        "opaDecisionLogEvent__erased",
        "opaDecisionLogEvent__masked",
        "opaDecisionLogEvent__error",
        "opaDecisionLogEvent__requested_by",
        "opaDecisionLogEvent__metrics",
        "opaDecisionLogEvent__req_id",
        "opaDecisionLogEvent__rule_labels",
        "opaDecisionLogEvent__request_context",
        "opaDecisionLogEvent__custom"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "labels",
          "description": "The labels of the OPA instance that made the decision: its `id`, its `version` and those the configuration sets.",
          "range": "OpaLabels",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "decision_id",
          "description": "The decision's id, which OPA also returns to the client.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "batch_decision_id",
          "description": "The id that groups the decisions of one batch request.",
          "@type": "SlotDefinition"
        },
        {
          "name": "trace_id",
          "description": "The request's trace id in W3C trace context, with tracing on.",
          "@type": "SlotDefinition"
        },
        {
          "name": "span_id",
          "description": "The request's span id in W3C trace context, with tracing on.",
          "@type": "SlotDefinition"
        },
        {
          "name": "bundles",
          "description": "The bundles whose policy made the decision, by name.",
          "range": "OpaDecisionBundle",
          "multivalued": true,
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "path",
          "description": "The decision's path in the data tree, such as `http/example/authz/allow`.",
          "@type": "SlotDefinition"
        },
        {
          "name": "query",
          "description": "The ad hoc query the Query API received.",
          "@type": "SlotDefinition"
        },
        {
          "name": "input",
          "description": "The input of the query.",
          "range": "OpaValue",
          "any_of": [
            {
              "range": "OpaValue",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "OpaValue",
              "multivalued": true,
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "result",
          "description": "The result the client received.",
          "range": "OpaValue",
          "any_of": [
            {
              "range": "OpaValue",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "OpaValue",
              "multivalued": true,
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "intermediate_results",
          "description": "The intermediate results the evaluation recorded, when OPA runs with the environment variable OPA_DECISIONS_INTERMEDIATE_RESULTS set.",
          "range": "OpaObject",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mapped_result",
          "description": "The result as the result mapper of a decision made through OPA's Go SDK wrote it.",
          "range": "OpaValue",
          "any_of": [
            {
              "range": "OpaValue",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "OpaValue",
              "multivalued": true,
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "nd_builtin_cache",
          "description": "What each non-deterministic built-in function returned, by function and arguments, with `nd_builtin_cache` on.",
          "range": "OpaObject",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "erased",
          "description": "JSON pointers to the fields a mask policy removed.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "masked",
          "description": "JSON pointers to the fields a mask policy replaced.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "error",
          "description": "The error the evaluation raised, as OPA writes it in JSON.",
          "range": "OpaValue",
          "any_of": [
            {
              "range": "OpaValue",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "OpaValue",
              "multivalued": true,
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "requested_by",
          "description": "The address of the client that asked.",
          "@type": "SlotDefinition"
        },
        {
          "name": "metrics",
          "description": "The query's metrics, by name.",
          "range": "OpaObject",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "req_id",
          "description": "The number OPA gave the HTTP request, which its request and response logs also carry.",
          "range": "integer",
          "minimum_value": 0,
          "@type": "SlotDefinition"
        },
        {
          "name": "rule_labels",
          "description": "The merged `labels` annotations of each rule the evaluation used.",
          "range": "OpaObject",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "request_context",
          "description": "The parts of the HTTP request the configuration asks OPA to log.",
          "range": "OpaRequestContext",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "custom",
          "description": "Fields the server or a plugin adds, such as `request_metadata`, the top-level keys of a Data API request body besides `input`.",
          "range": "OpaObject",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaDecisionLogEvent",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaDecisionBundle",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaDecisionBundle",
      "description": "A bundle whose policy made a decision.",
      "from_schema": "https://w3id.org/lmodel/opa/decision_log",
      "slots": [
        "OpaDecisionBundle_revision",
        "opaDecisionBundle__name"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "name",
          "description": "The bundle's name.",
          "slot_uri": "schema:name",
          "key": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaDecisionBundle",
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaRequestContext",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaRequestContext",
      "description": "The parts of the request that a decision log event logs.",
      "from_schema": "https://w3id.org/lmodel/opa/decision_log",
      "slots": [
        "opaRequestContext__http"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "http",
          "description": "The logged parts of the HTTP request.",
          "range": "OpaHttpRequestContext",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaRequestContext",
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaHttpRequestContext",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaHttpRequestContext",
      "description": "The logged parts of an HTTP request.",
      "from_schema": "https://w3id.org/lmodel/opa/decision_log",
      "slots": [
        "opaHttpRequestContext__headers"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "headers",
          "description": "The headers the configuration names, each with its values.",
          "range": "OpaStringListMap",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaHttpRequestContext",
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaStatusReport",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaStatusReport",
      "description": "A report on an OPA instance: the state of its bundles, its decision log uploads and its plugins, and its metrics.",
      "from_schema": "https://w3id.org/lmodel/opa/status_report",
      "slots": [
        "opaStatusReport__labels",
        "opaStatusReport__bundle",
        "opaStatusReport__bundles",
        "opaStatusReport__discovery",
        "opaStatusReport__decision_logs",
        "opaStatusReport__metrics",
        "opaStatusReport__plugins"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "labels",
          "description": "The labels of the OPA instance that sends the report.",
          "range": "OpaLabels",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "bundle",
          "description": "The status of the one bundle of the legacy `bundle` configuration.",
          "deprecated": "OPA marks the key deprecated and writes `bundles` instead.",
          "range": "OpaBundleStatus",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "bundles",
          "description": "The status of each bundle OPA downloads, by name.",
          "range": "OpaBundleStatus",
          "multivalued": true,
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "discovery",
          "description": "The status of the discovery bundle.",
          "range": "OpaBundleStatus",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "decision_logs",
          "description": "The status of the decision log uploads.",
          "range": "OpaDecisionLogStatus",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "metrics",
          "description": "The instance's metrics, under the name of their provider, such as `prometheus`.",
          "range": "OpaObject",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "plugins",
          "description": "The state of each plugin, by name.",
          "range": "OpaPluginStatus",
          "multivalued": true,
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaStatusReport",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaBundleStatus",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaBundleStatus",
      "description": "The status of a bundle: its active revision, when OPA last asked for, downloaded and activated it, and the errors of the last attempt.",
      "comments": [
        "OPA writes Go's zero time, 0001-01-01T00:00:00Z, for a time that has not come yet, such as the last activation of a bundle that never activated."
      ],
      "from_schema": "https://w3id.org/lmodel/opa/status_report",
      "slots": [
        "OpaBundleStatus_type",
        "opaBundleStatus__name",
        "opaBundleStatus__active_revision",
        "opaBundleStatus__last_successful_activation",
        "opaBundleStatus__size",
        "opaBundleStatus__last_successful_download",
        "opaBundleStatus__last_successful_request",
        "opaBundleStatus__last_request",
        "opaBundleStatus__code",
        "opaBundleStatus__message",
        "opaBundleStatus__errors",
        "opaBundleStatus__metrics",
        "opaBundleStatus__http_code"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "name",
          "description": "The bundle's name.",
          "slot_uri": "schema:name",
          "key": true,
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "active_revision",
          "description": "The revision of the bundle OPA last activated.",
          "@type": "SlotDefinition"
        },
        {
          "name": "last_successful_activation",
          "description": "When OPA last activated the bundle.",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "size",
          "description": "The bundle's size in bytes.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "last_successful_download",
          "description": "When OPA last downloaded the bundle.",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "last_successful_request",
          "description": "When a request for the bundle last succeeded.",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "last_request",
          "description": "When OPA last asked for the bundle.",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "code",
          "description": "The error code, when the last download or activation failed.",
          "@type": "SlotDefinition"
        },
        {
          "name": "message",
          "description": "What went wrong, in words.",
          "@type": "SlotDefinition"
        },
        {
          "name": "errors",
          "description": "The parse and compile errors of the last activation.",
          "range": "OpaObject",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "metrics",
          "description": "The metrics of the last download and activation.",
          "range": "OpaObject",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "http_code",
          "description": "The HTTP status code of a download the server refused.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/opa/OpaBundleStatus",
      "@type": "ClassDefinition"
    },
    {
      "name": "OpaDecisionLogStatus",
      "definition_uri": "https://w3id.org/lmodel/opa/OpaDecisionLogStatus",
      "description": "The status of the decision log uploads.",
      "from_schema": "https://w3id.org/lmodel/opa/status_report",
      "slots": [
