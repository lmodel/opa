  "description": "A LinkML model of eight of the JSON formats Open Policy Agent defines: the IR plan, the bundle manifest, the authorization policy input, the capabilities document, the built-in function metadata, the version index, the decision log event and the status report. Each module renders one format and keeps OPA's keys, so the schema checks a document OPA writes as it is, with no key renamed. The lokf adapt copy renames seven keys LOKF defines with another meaning.",
  "title": "Open Policy Agent (OPA)",
  "source": "https://github.com/open-policy-agent/opa/tree/482d9e368c2ddfed67ced59259fa6a247bb5f1e5",
  "see_also": [
    "https://lmodel.github.io/opa",
    "https://www.openpolicyagent.org/docs"
  ],
  "keywords": [
    "policy as code",
    "Open Policy Agent",
    "Rego",
    "CNCF"
  ],
  "id": "https://w3id.org/lmodel/opa",
  "version": "1.22.2",
  "imports": [
    "linkml:types",
    "common",
    "capabilities",
    "builtin_metadata",
    "version_index",
    "authorization_input",
    "bundle_manifest",
    "ir_plan",
    "decision_log",
    "status_report"
  ],
  "license": "Apache-2.0",
  "prefixes": [
    {
      "prefix_prefix": "openpolicyagent",
      "prefix_reference": "https://w3id.org/lmodel/opa/"
    },
